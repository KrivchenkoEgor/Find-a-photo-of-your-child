# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Виртуальное окружение
.venv/
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Фотографии ребёнка — личные данные, никогда не коммитить и не выгружать
data/
ref/
# Путь к боевому архиву и список подтверждённых снимков: имена файлов — тоже личные
# данные. В репозитории лежит только arhiv.example.json с заглушками.
arhiv.local.json
*.jpg
*.jpeg
*.png
*.heic
*.webp
# Тестовый снимок не публикуется: это стоковая фотография с водяным знаком агентства,
# и в коде она не нужна — ни один тест или скрипт её не читает.
assets/samples/
# кроме мастер-файла иконки: он вход сборки, а не фото пользователя. Без него
# пересобрать `.icns` можно только нарисовав картинку заново руками.
!assets/*.png

# Результаты работы
output/
logs/
*.log

# Модели (слишком большие для GitHub)
models/
*.onnx
*.pth
# кроме модели YuNet: 230 КБ, и без них первый запуск с клона не разбирает ни одной
# папки. `!assets/models/` обязателен отдельной строкой: правило `models/` выше
# вычёркивает саму папку, а обратно включить файл внутри исключённого каталога git
# уже не позволяет — на `!*.onnx` молчало бы ровно то, ради чего оно написано.
!assets/models/
!assets/models/*.onnx

# Секреты (AGENTS.md: .env никогда не коммитится)
.env
.env.*
!.env.example

# Резервные снимки документов
.backup-*/

# Временные файлы
*.tmp
*.bak

# Сборка PyInstaller
build/
dist/
# Общий запрет `.spec` — это про leftover-файлы сборки в корне. Сама спецификация
# FindChild.spec — исходник: в ней решается, какие веса и плагины едут в архив,
# и без неё сборку на новом месте не повторить.
*.spec
!FindChild.spec

# Инсталляторы
*.exe
*.dmg
*.pkg

# Случайные базы в корне: оглавление приложения живёт в служебной папке пользователя
*.sqlite3

# -----------------------------------------------------------------------------
# Что не публикуется и почему. Эти файлы остаются на диске автора, но в публичный
# репозиторий не едут: `git add -A` не должен зависеть от того, помнит ли человек,
# что он собирался исключить.
# -----------------------------------------------------------------------------

# Исходный скрипт-эталон: в нём прописаны личные абсолютные пути
Findchild.py

# Рабочие журналы: цитируют имена снимков и путь семейного архива
progress.md
checkpoint.md
docs/bench-*.md
docs/superpowers/plans/

# Калибровочные зонды одноразовой работы: у каждого в коде жёстко стоит путь к архиву
# и имена конкретных фото. Выводы из них перенесены в LESSONS.md и спецификацию.
analyze_threshold.py
bench_*.py
